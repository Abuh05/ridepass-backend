# ---------- Server ----------
PORT=8080
PUBLIC_BASE_URL=https://ridepass.example.com     # public HTTPS URL (WhatsApp needs HTTPS)
NODE_ENV=production                              # refuses to start without real keys in production
DB_PATH=./data/ridepass.db
DATA_DIR=./data

# ---------- N-ATLAS models (GPU box running model-service/start.sh) ----------
MODEL_MODE=natlas                                # natlas | mock (mock = UI work only, never for the pilot)
ASR_URL=https://<gpu-host>:9000
LLM_BASE_URL=https://<gpu-host>:8000/v1
LLM_MODEL=n-atlas
MODEL_SERVICE_TOKEN=                             # same value as on the GPU box

# ---------- WhatsApp Cloud API (Meta for Developers → WhatsApp → API setup) ----------
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=choose-a-random-string
WA_APP_SECRET=
WA_GRAPH_VERSION=v21.0
WA_TEMPLATES_APPROVED=                           # e.g. ridepass_payment_confirm,ridepass_daily_reminder,ridepass_access_request

# ---------- Secrets (generate with: npm run keys) ----------
DATA_KEY=
HASH_KEY=
ADMIN_API_KEY=
SIGNING_PRIVATE_KEY=
SIGNING_PUBLIC_KEY=

# ---------- Rules ----------
USER_CAP=1000                                    # N-ATLAS research licence: 1,000 active end-users
MIN_SCORE_DAYS=14
REMINDER_HOUR_LAGOS=19
RETAIN_AUDIO=1                                   # keep audio ONLY for riders who opted in (benchmark set)

# ---------- EV calculator (replace with Phoenix's real numbers) ----------
EV_PETROL_PRICE=1000
EV_ELECTRICITY_PRICE=209
EV_KEKE_CONVERSION=2500000
EV_OKADA_CONVERSION=1200000
