{
  "name": "ridepass",
  "version": "0.1.0",
  "private": true,
  "description": "RidePass — voice-first credit passport for Nigerian commercial riders, built on N-ATLAS",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/server.ts",
    "dev": "node --watch --experimental-strip-types --disable-warning=ExperimentalWarning src/server.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"test/*.test.ts\"",
    "keys": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/genkeys.ts",
    "simulate": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/simulate.ts",
    "bench:nlu": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/bench-nlu.ts",
    "export:interactions": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/export.ts"
  },
  "comment": "Zero runtime dependencies on purpose: uses Node's built-in http, sqlite, crypto, fetch and test runner. Nothing to npm install."
}
