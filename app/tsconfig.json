{
  "//": "Optional: editor type-checking only (npx tsc). The app runs directly on Node's built-in TypeScript stripping.",
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true, "noEmit": true, "strict": true, "skipLibCheck": true,
    "erasableSyntaxOnly": true, "verbatimModuleSyntax": false, "types": ["node"]
  },
  "include": ["src", "scripts", "test"]
}
